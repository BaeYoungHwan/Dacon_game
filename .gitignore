# ───────────────────────────────
# 환경 변수 & 시크릿
# ───────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
config/secrets.*
# .env.example 은 템플릿이므로 커밋 허용

# ───────────────────────────────
# Node / Vite / React
# ───────────────────────────────
node_modules/
dist/
build/
.next/
*.local            # vite.config.*.local 등 로컬 오버라이드

# ───────────────────────────────
# 테스트 / 커버리지
# ───────────────────────────────
coverage/
*.lcov
.nyc_output/

# ───────────────────────────────
# Python (스크립트 실행 시)
# ───────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# ───────────────────────────────
# 로그 (협업 불필요 — 로컬 감사용)
# ───────────────────────────────
logs/
*.log
!logs/.gitkeep

# ───────────────────────────────
# 빈 폴더 유지 앵커
# ───────────────────────────────
!docs/exec-plans/active/.gitkeep
!docs/exec-plans/completed/.gitkeep

# ───────────────────────────────
# IDE (개인 설정 — 협업 불필요)
# ───────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ───────────────────────────────
# OS 부산물
# ───────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ───────────────────────────────
# Claude Code (개인 세션 — 협업 불필요)
# ───────────────────────────────
.claude/sessions/
memory/
