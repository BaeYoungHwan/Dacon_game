# ───────────────────────────────
node_modules/
dist/
build/
.next/
out/
# vite.config.*.local 등 로컬 오버라이드
*.local

# 빌드 / 타입 캐시
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/

# ───────────────────────────────
# 테스트 / 커버리지
