# ───────────────────────────────
# 환경 변수 & 시크릿
# ───────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
config/secrets.*
# .env.example 은 템플릿이므로 커밋 허용

# 인증서 / 개인키 (절대 커밋 금지)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks

# ───────────────────────────────
